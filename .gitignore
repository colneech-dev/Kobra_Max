# Source insight project files
/SI/*
*.si4project/


# PlatformIO / build output
.pio/
.vscode/
__pycache__/
*.pyc

# Claude Code local state
.claude/

# Local reference trees and vendor dumps (hundreds of MB)
DGUS/
_marlin_upstream/

# Generated release packages (rebuild with tools/build_release.py; it only writes folders named release*)
/release*/

# The stock Anycubic display files that tools/patch_14showfile.py and generate_dwin_controls.py start from, and the display OS.
# They are small and needed to rebuild a display set, so they are tracked despite the *.bin rule above.
!DWIN_SET/*.base.bin
!DWIN_SET/DWINOS.bin

# Microsoft fonts the screen art is drawn with (licence: do not commit them; see tools/fonts/README.md)
tools/fonts/segoe*.ttf

# Script-generated display artefacts (rebuild with tools/build_icl.py / generate_spinner_icons.py)
DWIN_SET/auto_icl/
DWIN_SET/spinner_icons/

# Release builds use their own build folder (tools/build_release.py) so an IDE build in .pio cannot collide with them
.pio_release/
build_logs/

# Vendor documents: kept on the developer's PC only (redistribution terms unclear). Links: docs/reference/README.md
docs/reference/*.pdf
docs/reference/*.txt
source/Marlin/src/HAL/HC32/docs/*.pdf
